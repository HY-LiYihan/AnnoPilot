ROSETTA_WEBHOOK_SECRET=replace-with-a-long-random-secret
ROSETTA_WEBHOOK_HOST=127.0.0.1
ROSETTA_WEBHOOK_PORT=9010
ROSETTA_ALLOWED_REPOSITORY=HY-LiYihan/AnnoPilot
ROSETTA_ALLOWED_REF=main
ROSETTA_MAX_PAYLOAD_AGE_SECONDS=900

ROSETTA_DEPLOY_COMMAND=/opt/rosetta/bin/deploy.sh
ROSETTA_DEPLOY_MODE=image
ROSETTA_DEPLOY_TIMEOUT_SECONDS=900
ROSETTA_APP_DIR=/opt/rosetta
ROSETTA_COMPOSE_FILE=/opt/rosetta/compose.yml
ROSETTA_HEALTH_URL=http://127.0.0.1:8501/api/health

# If the webhook service runs as a non-root user that has passwordless sudo,
# set this to: sudo -n docker
ROSETTA_DOCKER_COMMAND=docker
