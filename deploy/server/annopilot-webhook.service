[Unit]
Description=AnnoPilot deployment webhook
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/opt/annopilot/webhook.env
ExecStart=/usr/bin/python3 /opt/annopilot/bin/webhook.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/annopilot /tmp

[Install]
WantedBy=multi-user.target
