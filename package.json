{
  "name": "annopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "DATABASE_PATH=.runtime/annopilot.sqlite DATA_ROOT=.runtime/projects uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 0.0.0.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.30.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitepress": "^1.6.4",
    "vue-tsc": "^2.2.0"
  }
}
